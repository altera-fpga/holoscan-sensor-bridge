# clock/global reset
set_location_assignment PIN_CM29 -to clk_100_mhz -comment "SI5332E-D-GM2 OUT6, default to 100MHz"
set_location_assignment PIN_AB53 -to rst_pb_n  -comment "pin FPGA_RESETn"

# push buttons
set_location_assignment PIN_CY47 -to user_pb_n[0] -comment "f_gpio0"
set_location_assignment PIN_CW48 -to user_pb_n[1] -comment "f_gpio1"

# max 10 switch/led 
set_location_assignment PIN_Y49 -to fpga_sgpio_sync
set_location_assignment PIN_W48 -to fpga_sgpio_clk
set_location_assignment PIN_T49 -to fpga_sgpi
set_location_assignment PIN_U48 -to fpga_sgpo



#=================================================================================

set_instance_assignment -name IO_STANDARD "TRUE DIFFERENTIAL SIGNALING" -to clk_100_mhz -entity AGX_FM87_Devkit_HSB_NVQLINK_100GbE
set_instance_assignment -name INPUT_TERMINATION DIFFERENTIAL -to clk_100_mhz -entity AGX_FM87_Devkit_HSB_NVQLINK_100GbE

set_instance_assignment -name IO_STANDARD "1.2 V" -to rst_pb_n -entity AGX_FM87_Devkit_HSB_NVQLINK_100GbE

set_instance_assignment -name IO_STANDARD "1.2 V" -to user_pb_n[0] -entity AGX_FM87_Devkit_HSB_NVQLINK_100GbE
set_instance_assignment -name IO_STANDARD "1.2 V" -to user_pb_n[1] -entity AGX_FM87_Devkit_HSB_NVQLINK_100GbE

set_instance_assignment -name IO_STANDARD "1.2 V" -to fpga_sgpio_sync -entity AGX_FM87_Devkit_HSB_NVQLINK_100GbE
set_instance_assignment -name IO_STANDARD "1.2 V" -to fpga_sgpio_clk -entity AGX_FM87_Devkit_HSB_NVQLINK_100GbE
set_instance_assignment -name IO_STANDARD "1.2 V" -to fpga_sgpi -entity AGX_FM87_Devkit_HSB_NVQLINK_100GbE
set_instance_assignment -name IO_STANDARD "1.2 V" -to fpga_sgpo -entity AGX_FM87_Devkit_HSB_NVQLINK_100GbE


set_global_assignment -name VERILOG_FILE ../non_qpds_ip/shell/sgpio_slave.v

#=====================================================================
# from GSRD / golden_top.qsf

set_global_assignment -name USE_PWRMGT_SCL SDM_IO0
set_global_assignment -name USE_PWRMGT_SDA SDM_IO12
set_global_assignment -name USE_CONF_DONE SDM_IO16
set_global_assignment -name PWRMGT_SLAVE_DEVICE_TYPE LTC3888
set_global_assignment -name PWRMGT_SLAVE_DEVICE0_ADDRESS 62
set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "LINEAR FORMAT"
set_global_assignment -name PWRMGT_LINEAR_FORMAT_N "-12" 
#set_global_assignment -name ACTIVE_SERIAL_CLOCK AS_FREQ_115MHZ_IOSC
set_global_assignment -name ACTIVE_SERIAL_CLOCK AS_FREQ_125MHZ
set_global_assignment -name STRATIXV_CONFIGURATION_SCHEME "ACTIVE SERIAL X4"


#======================================================================

set_global_assignment -name GENERATE_COMPRESSED_SOF ON

# set_global_assignment -name DISABLE_REGISTER_POWER_UP_INITIALIZATION ON
# set_global_assignment -name INI_VARS "ASM_ENABLE_ADVANCED_DEVICES=ON;"
# set_global_assignment -name PWRMGT_PAGE_COMMAND_ENABLE OFF
# set_global_assignment -name PWRMGT_SLAVE_DEVICE1_ADDRESS 00
# set_global_assignment -name PWRMGT_SLAVE_DEVICE2_ADDRESS 00
# set_global_assignment -name PWRMGT_SLAVE_DEVICE3_ADDRESS 00
# set_global_assignment -name PWRMGT_SLAVE_DEVICE4_ADDRESS 00
# set_global_assignment -name PWRMGT_SLAVE_DEVICE5_ADDRESS 00
# set_global_assignment -name PWRMGT_SLAVE_DEVICE6_ADDRESS 00
# set_global_assignment -name PWRMGT_SLAVE_DEVICE7_ADDRESS 00

set_global_assignment -name DEVICE_INITIALIZATION_CLOCK OSC_CLK_1_125MHZ


set_global_assignment -name IP_FILE ../rtl/shell/ip/board_subsystem/board_subsystem_board_pb_reset_generator.ip
set_global_assignment -name IP_FILE ../rtl/shell/ip/board_subsystem/board_subsystem_io_data_rst_bridge.ip
set_global_assignment -name IP_FILE ../rtl/shell/ip/board_subsystem/board_subsystem_board_init_generator.ip
set_global_assignment -name IP_FILE ../rtl/shell/ip/board_subsystem/board_subsystem_board_reset_controller.ip
set_global_assignment -name IP_FILE ../rtl/shell/ip/board_subsystem/board_subsystem_board_init_reset_bridge.ip
set_global_assignment -name IP_FILE ../rtl/shell/ip/board_subsystem/board_subsystem_io_data_clk_bridge.ip
set_global_assignment -name IP_FILE ../rtl/shell/ip/board_subsystem/board_subsystem_board_clk_bridge.ip
set_global_assignment -name QSYS_FILE ../rtl/shell/board_subsystem.qsys
