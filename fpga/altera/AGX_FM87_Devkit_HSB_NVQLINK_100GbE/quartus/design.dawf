::drc::add_waiver \
	-rule_id {RES-50001} \
	-query_string {"Reset Source" =~ 'eth_intf_reset_sync' && "Sample Register Being Reset" =~ 'u_rst_gen' && "Sample Register Being Reset" =~ 'aasr_rst_q'} \
	-tag {eth-to-hsb-reset-crossing} \
        -stages {{Timing Signoff}} \
	-description {eth_intf_reset_sync reset_out is already synchronized before reaching hsb_subsystem. hsb's own u_rst_gen re-synchronizes it again locally per-domain via its aasr_rst_q (async-assert/sync-release) chain, which hsb_subsystem.sdc already false-paths.} \
	-owner {user} \
	-no_warn
